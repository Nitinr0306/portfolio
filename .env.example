# Public origin of the deployed site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form delivery via Resend (https://resend.com). If these are not set,
# the form falls back to opening a pre-filled email in the visitor's mail app.
RESEND_API_KEY=
CONTACT_TO_EMAIL=nitinr0306@gmail.com
# Must be an address on a domain you have verified in Resend.
CONTACT_FROM_EMAIL="Portfolio <contact@your-domain.com>"
